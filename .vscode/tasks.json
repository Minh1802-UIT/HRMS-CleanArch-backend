{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Employee.API/Employee.API.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/Employee.API/Employee.API.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/Employee.API/Employee.API.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "test-backend-unit",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"Employee.UnitTests/Employee.UnitTests.csproj",
				"--configuration",
				"Release"
			],
			"isBackground": false
		}
	]
}