{
  "servers": {
    "MongoDB": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${env:MONGO_URI}",
        "MONGODB_CONNECTION_STRING": "${env:MONGO_URI}"
      }
    }
  }
}